---
import { siteConfig } from "../config";
---

<header class="pt-12 pb-20 md:pt-20 md:pb-32 px-6">
  <div class="max-w-6xl mx-auto">
    <h1
      class="text-5xl md:text-7xl font-bold mb-6 text-white leading-tight tracking-tight"
      data-reveal
    >
      Senior Frontend &<br />
      <span class="text-gray-500">React Native Engineer</span>
    </h1>
    <p
      class="text-xl md:text-2xl text-gray-400 max-w-2xl mb-10 font-light"
      data-reveal
      data-reveal-delay="1"
    >
      Hi, I'm Temitope. Senior Frontend & React Native Engineer with 6+ years building web and mobile
      products for fintech, education, and e-commerce — specializing in React Native (Expo), Next.js,
      and event-driven architectures.
    </p>
    <p class="text-sm text-gray-500 mb-10" data-reveal data-reveal-delay="2">
      Ibadan, Nigeria · Remote (UTC+1) · <span class="text-emerald-400">Open to remote roles</span>
    </p>
    <div class="flex flex-wrap gap-4" data-reveal data-reveal-delay="3">
      <a
        class="bg-white text-black hover:bg-gray-200 px-6 py-3 rounded-full font-medium transition-colors flex items-center gap-2"
        href={siteConfig.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="material-symbols-outlined text-[20px]">download</span>
        Download Resume
      </a>
      <a
        class="border border-gray-700 text-gray-300 hover:text-white hover:border-gray-500 px-6 py-3 rounded-full font-medium transition-colors flex items-center gap-2"
        href="https://github.com/devdre1909"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub Profile
      </a>
    </div>
  </div>
</header>
